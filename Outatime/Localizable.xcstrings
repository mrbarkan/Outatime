    "Dragging an edge moves only that block and stops at the next one. Hold ⌥ to move the border between two blocks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Kante ziehst, bewegt sich nur dieser Block und stoppt am nächsten. Halte ⌥, um die Grenze zwischen zwei Blöcken zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastrar un borde mueve solo ese bloque y se detiene en el siguiente. Mantén ⌥ para mover el límite entre dos bloques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire glisser un bord ne déplace que ce bloc et s’arrête au suivant. Maintenez ⌥ pour déplacer la limite entre deux blocs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascinare un bordo sposta solo quel blocco e si ferma al successivo. Tieni premuto ⌥ per spostare il confine tra due blocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端をドラッグすると、そのブロックだけが動き、次のブロックで止まります。2つのブロックの境目を動かすには⌥を押しながらドラッグします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastar uma borda move só aquele bloco e para no seguinte. Segure ⌥ para mover o limite entre dois blocos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移边缘时只会移动该时段，并在下一个时段处停止。按住 ⌥ 可移动两个时段之间的分界。"
          }
        }
      }
    },
