    "Weekends and days off owe nothing; mark a day off from the Logbook toolbar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wochenenden und freie Tage haben kein Soll; markiere einen freien Tag in der Symbolleiste des Logbuchs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fines de semana y días libres no deben horas; marca un día libre desde la barra de la Bitácora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les week-ends et les jours de congé ne doivent rien ; marquez un jour de congé depuis la barre d’outils du Journal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekend e giorni liberi non richiedono ore; segna un giorno libero dalla barra strumenti del Diario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末と休日は目標時間がありません。休日は日誌のツールバーから設定できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fins de semana e folgas não devem horas; marque uma folga na barra do Diário de bordo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周末和休息日没有应工作时长；可在日志工具栏中标记休息日。"
          }
        }
      }
    },
