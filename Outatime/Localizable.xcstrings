    "Once your day reaches its target, Work carries on as Extra by itself. Weekends and days off count as Extra.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald dein Tag das Ziel erreicht, läuft Arbeit von selbst als Extra weiter. Wochenenden und freie Tage zählen als Extra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando tu día alcanza la meta, Trabajo sigue como Extra por sí solo. Los fines de semana y días libres cuentan como Extra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois l’objectif du jour atteint, Travail continue automatiquement en Extra. Les week-ends et les jours de congé comptent en Extra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la giornata raggiunge l'obiettivo, Lavoro prosegue da solo come Extra. Weekend e giorni liberi contano come Extra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日の目標に達すると、仕事は自動的に残業として続きます。週末と休日は残業として扱われます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o dia atinge a meta, Trabalho continua como Extra sozinho. Fins de semana e folgas contam como Extra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当天达到目标后，工作会自动转为加班。周末和休息日均计为加班。"
          }
        }
      }
    },
