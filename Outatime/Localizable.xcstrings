    "A tiny menu bar time tracker for macOS.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pequeño registro de horas en la barra de menús de macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pequeno controle de horas na barra de menus do macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit suivi du temps dans la barre des menus de macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine Zeiterfassung in der Menüleiste von macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piccolo tracker del tempo nella barra dei menu di macOS."
