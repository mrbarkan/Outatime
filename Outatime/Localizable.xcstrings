    "A block of a few minutes no longer covers the title of the one after it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Block von wenigen Minuten verdeckt nicht mehr den Titel des nächsten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bloque de pocos minutos ya no tapa el título del siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bloc de quelques minutes ne masque plus le titre du suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un blocco di pochi minuti non copre più il titolo di quello successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数分間のブロックが、次のブロックのタイトルに重ならなくなりました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um bloco de poucos minutos não cobre mais o título do seguinte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几分钟的短时段不再遮挡下一个时段的标题。"
          }
        }
      }
    },
    "A nudge to get up after every 50 minutes of work. Change it or turn it off in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hinweis, nach je 50 Minuten Arbeit aufzustehen. Ändere oder deaktiviere ihn in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso para levantarte cada 50 minutos de trabajo. Cámbialo o desactívalo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel pour vous lever toutes les 50 minutes de travail. Modifiez-le ou désactivez-le dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria per alzarti ogni 50 minuti di lavoro. Modificalo o disattivalo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "50分作業するごとに、立ち上がるよう知らせます。設定で変更したりオフにしたりできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete para levantar a cada 50 minutos de trabalho. Altere ou desative nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每工作 50 分钟提醒你起身活动。可在“设置”中更改或关闭。"
          }
        }
      }
    },
