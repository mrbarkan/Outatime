    "You've been at it for %@. Get up and move a little.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist seit %@ dran. Steh auf und beweg dich ein wenig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas %@ seguido. Levántate y muévete un poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes à la tâche depuis %@. Levez-vous et bougez un peu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei all'opera da %@. Alzati e muoviti un po'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@続けて作業しています。立ち上がって少し体を動かしましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está nisso há %@. Levante e se mexa um pouco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已连续工作 %@。起来活动一下吧。"
          }
        }
