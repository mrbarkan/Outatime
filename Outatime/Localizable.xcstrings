    "See your version and build, and write to support with them already filled in. Open it from the ••• menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Version und Build und schreibt dem Support mit beidem schon ausgefüllt. Öffne es im Menü •••."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tu versión y compilación, y escribe a soporte con ambas ya rellenadas. Ábrelo desde el menú •••."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche votre version et votre build, et écrit au support avec les deux déjà remplis. Ouvrez-le depuis le menu •••."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra versione e build e scrive al supporto con entrambe già compilate. Aprilo dal menu •••."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンとビルドを表示し、それらを記入済みでサポートに連絡できます。•••メニューから開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra sua versão e build, e escreve para o suporte com as duas já preenchidas. Abra pelo menu •••."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看版本和构建号，并在已自动填好它们的情况下联系支持。从 ••• 菜单打开。"
          }
        }
      }
    },
    "Settings are split into five short tabs: General, Target, Focus, Clients and Updates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen sind auf fünf kurze Tabs verteilt: Allgemein, Ziel, Fokus, Kunden und Updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Ajustes se dividen en cinco pestañas cortas: General, Meta, Enfoque, Clientes y Actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Réglages sont répartis en cinq onglets courts : Général, Objectif, Concentration, Clients et Mises à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Impostazioni sono divise in cinque schede brevi: Generali, Obiettivo, Concentrazione, Clienti e Aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定が「一般」「目標」「集中」「クライアント」「アップデート」の5つの短いタブに分かれました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Ajustes agora têm cinco abas curtas: Geral, Meta, Foco, Clientes e Atualizações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置现分为五个简短的标签页：通用、目标、专注、客户和更新。"
          }
        }
      }
    },
