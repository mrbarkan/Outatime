    "Activity names line up across each row, and Logbook and Export look alike.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Namen der Aktivitäten stehen in jeder Reihe auf einer Linie, und Logbuch und Exportieren sehen gleich aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de las actividades se alinean en cada fila, y Bitácora y Exportar se ven iguales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms des activités sont alignés sur chaque ligne, et Journal et Exporter se ressemblent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi delle attività sono allineati in ogni riga, e Diario ed Esporta hanno lo stesso aspetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各行のアクティビティ名がそろい、「日誌」と「書き出す」が同じ見た目になりました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes das atividades ficam alinhados em cada linha, e Diário de bordo e Exportar têm a mesma aparência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行的活动名称对齐，“日志”和“导出”的样式一致。"
          }
        }
      }
    },
