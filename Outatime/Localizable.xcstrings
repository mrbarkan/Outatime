    "⌃⌥⌘W starts or stops Work, ⌃⌥⌘B Break": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥⌘W startet oder stoppt Arbeit, ⌃⌥⌘B Pause"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥⌘W inicia o detiene Trabajo, ⌃⌥⌘B Pausa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥⌘W lance ou arrête Travail, ⌃⌥⌘B Pause"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥⌘W avvia o ferma Lavoro, ⌃⌥⌘B Pausa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥⌘Wで仕事、⌃⌥⌘Bで休憩を開始・停止"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥⌘W inicia ou para Trabalho, ⌃⌥⌘B Pausa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃⌥⌘W 开始或停止工作，⌃⌥⌘B 休息"
          }
        }
      }
    },
    "⌘-click or ⇧-click blocks in the Logbook, then right-click to give them a client, change their activity or delete them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke im Logbuch mit ⌘ oder ⇧ auf Blöcke und dann mit rechts, um ihnen einen Kunden zuzuweisen, ihre Aktivität zu ändern oder sie zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz ⌘-clic o ⇧-clic en los bloques de la Bitácora y luego clic derecho para asignarles un cliente, cambiar su actividad o eliminarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-cliquez ou ⇧-cliquez sur des blocs dans le Journal, puis faites un clic droit pour leur attribuer un client, changer leur activité ou les supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai ⌘-clic o ⇧-clic sui blocchi nel Diario, poi clic destro per assegnare un cliente, cambiare attività o eliminarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日誌でブロックを⌘クリックまたは⇧クリックし、右クリックすると、クライアントの割り当て、アクティビティの変更、削除ができます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com ⌘ ou ⇧ nos blocos do Diário de bordo e use o clique direito para atribuir um cliente, mudar a atividade ou excluí-los."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在日志中按住 ⌘ 或 ⇧ 点按多个时段，然后右键点按，即可指定客户、更改活动或删除。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
