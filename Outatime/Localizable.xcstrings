    "Outatime now also speaks French, German, Italian, Japanese and Simplified Chinese. Pick yours in Settings → General.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outatime spricht jetzt auch Französisch, Deutsch, Italienisch, Japanisch und vereinfachtes Chinesisch. Wähle deine Sprache unter Einstellungen → Allgemein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Outatime ahora también habla francés, alemán, italiano, japonés y chino simplificado. Elige el tuyo en Ajustes → General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outatime parle désormais aussi français, allemand, italien, japonais et chinois simplifié. Choisissez votre langue dans Réglages → Général."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Outatime ora parla anche francese, tedesco, italiano, giapponese e cinese semplificato. Scegli la tua lingua in Impostazioni → Generali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Outatimeがフランス語、ドイツ語、イタリア語、日本語、簡体字中国語にも対応しました。設定 → 一般で選べます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Outatime agora também fala francês, alemão, italiano, japonês e chinês simplificado. Escolha o seu em Ajustes → Geral."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Outatime 现在还支持法语、德语、意大利语、日语和简体中文。可在“设置”→“通用”中选择。"
          }
        }
      }
    },
