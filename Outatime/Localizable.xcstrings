    "Export a client's month for invoicing from the Export menu. Reports also gain a Client column and a Clients sheet; export a fresh master workbook so new months paste in cleanly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere den Monat eines Kunden zur Abrechnung über das Menü „Exportieren“. Berichte erhalten außerdem eine Spalte „Kunde“ und ein Blatt „Kunden“; exportiere eine neue Gesamtmappe, damit sich neue Monate sauber einfügen lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta el mes de un cliente para facturar desde el menú Exportar. Los informes ganan además una columna Cliente y una hoja Clientes; exporta un libro maestro nuevo para que los meses nuevos se peguen bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez le mois d’un client pour le facturer depuis le menu Exporter. Les rapports gagnent aussi une colonne Client et une feuille Clients ; exportez un nouveau classeur principal pour que les nouveaux mois s’y collent proprement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta il mese di un cliente per la fatturazione dal menu Esporta. I report ora hanno anche una colonna Cliente e un foglio Clienti; esporta una nuova cartella principale così i nuovi mesi si incollano senza problemi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「書き出す」メニューから、請求用にクライアントの1か月分を書き出せます。レポートにはクライアント列とクライアントシートも加わりました。新しい月をきれいに貼り付けられるよう、マスターブックを新たに書き出してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte o mês de um cliente para faturar pelo menu Exportar. Os relatórios também ganham uma coluna Cliente e uma planilha Clientes; exporte uma pasta de trabalho mestre nova para que os novos meses sejam colados certinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“导出”菜单导出某个客户的月度数据用于开票。报告还新增了“客户”列和“客户”工作表；请重新导出主工作簿，以便顺利粘贴新月份。"
          }
        }
      }
    },
