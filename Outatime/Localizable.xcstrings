    "With three or more clients the menu no longer runs off its edge. Clients now sit in a grid of buttons.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit drei oder mehr Kunden läuft das Menü nicht mehr über den Rand. Kunden stehen jetzt in einem Raster aus Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tres o más clientes el menú ya no se sale por el borde. Los clientes aparecen ahora en una cuadrícula de botones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec trois clients ou plus, le menu ne déborde plus. Les clients sont désormais dans une grille de boutons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tre o più clienti il menu non esce più dal bordo. I clienti ora sono in una griglia di pulsanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアントが3件以上でもメニューからはみ出さなくなりました。クライアントはボタンのグリッドに並びます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com três ou mais clientes, o menu não passa mais da borda. Os clientes agora ficam numa grade de botões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有三个或更多客户时，菜单不再超出边缘。客户现在以按钮网格排列。"
          }
        }
      }
    },
